<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Home tab's Calendar card reads EventKit. The app is not sandboxed, but
	     hardened runtime still needs this for the Calendars privacy prompt. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- The floating bar's music part asks the Music app what is playing and
	     controls it over Apple Events. Hardened runtime needs this to send them. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
